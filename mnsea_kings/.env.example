# Copy this file to `.env` (same folder as manage.py) and fill in your real
# values. `.env` is already in .gitignore so your secret keys never get
# committed to source control.

DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Razorpay (get instant TEST mode keys free at https://dashboard.razorpay.com) ---
# Dashboard > Settings > API Keys > Generate Test Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard > Settings > Webhooks > Add New Webhook > set any secret string here
# (needed only if you set up the webhook URL described in the README)
RAZORPAY_WEBHOOK_SECRET=

# --- CORS (only needed once you deploy the API somewhere the mobile app can
# reach it from a different domain; leave blank for local development) ---
# Example: CORS_ALLOWED_ORIGINS=https://mnseakings.in,https://app.mnseakings.in
CORS_ALLOWED_ORIGINS=

# Production example:
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
